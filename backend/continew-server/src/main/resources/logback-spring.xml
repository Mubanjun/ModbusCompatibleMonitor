<?xml version="1.0" encoding="UTF-8"?>
<!-- 日志级别从低到高分为 TRACE < DEBUG < INFO < WARN < ERROR < FATAL，如果设置为 WARN，则低于 WARN 的信息都不会输出 -->
<!-- scan：当此属性设置为 true 时，配置文档如果发生改变，将会被重新加载，默认值为 true -->
<!-- scanPeriod：设置监测配置文档是否有修改的时间间隔，如果没有给出时间单位，默认单位是毫秒。
       当 scan 为 true 时，此属性生效。默认的时间间隔为 1 分钟。 -->
<!-- debug：当此属性设置为 true 时，将打印出 logback 内部日志信息，实时查看 logback 运行状态。默认 false。 -->
<configuration debug="false" scan="true" scanPeriod="30 seconds">

    <!-- 关闭 Logback 的状态监听器（通过更换默认状态监听器实现） -->
    <statusListener class="ch.qos.logback.core.status.NopStatusListener"/>

    <!-- 消息脱敏（NFR-SEC-07）：日志与诊断包里出现手机号/身份证/邮箱/银行卡时自动打码 -->
    <conversionRule conversionWord="maskedMsg"
        converterClass="top.continew.admin.monitor.runtime.security.MaskedMessageConverter"/>

    <!-- 消息脱敏（NFR-SEC-07）：日志与诊断包里出现手机号/身份证/邮箱/银行卡时自动打码 -->
    <conversionRule conversionWord="maskedMsg"
        converterClass="top.continew.admin.monitor.runtime.security.MaskedMessageConverter"/>

    <!-- 应用名 -->
    <springProperty name="APP_NAME" source="spring.application.name" scope="context"/>
    <!-- 保存路径 -->
    <property name="LOG_PATH" value="${LOG_PATH:-./logs}"/>
    <!-- 字符集 -->
    <property name="LOG_CHARSET" value="utf-8"/>
    <!-- 采集/上报等关键日志携带 traceId、设备、端口、批次、任务等 MDC 上下文字段（FR-LOG-02），可按字段检索 -->
    <property name="MDC_PATTERN" value="traceId=%X{traceId:-} device=%X{device:-} port=%X{port:-} batch=%X{batch:-} task=%X{task:-}"/>
    <!-- 控制台输出格式（带颜色） -->
    <property name="CONSOLE_LOG_PATTERN" value="%red(%d{yyyy-MM-dd HH:mm:ss.SSS}) %highlight(%-5level) %green([%thread]) %boldMagenta(%logger{50}) ${MDC_PATTERN} - %maskedMsg%n"/>
    <!-- 文件输出格式（%maskedMsg：脱敏后的消息，见 MaskedMessageConverter） -->
    <property name="FILE_LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] ${MDC_PATTERN} %logger{50} - %maskedMsg%n"/>
    <!-- 单个日志文件大小上限（FR-LOG-03 按大小轮转） -->
    <property name="FILE_MAX_SIZE" value="${LOG_FILE_MAX_SIZE:-20MB}"/>
    <!-- 日志保留天数（根据国家法律，网络运行状态、网络安全事件、个人敏感信息操作等相关记录，留存的日志不少于六个月，并且进行网络多机备份。） -->
    <property name="FILE_MAX_HISTORY" value="${LOG_FILE_MAX_HISTORY:-180}"/>
    <!-- 全量日志占用上限（FR-LOG-03 限制总占用，磁盘不因日志写满） -->
    <property name="TOTAL_SIZE_CAP" value="${LOG_TOTAL_SIZE_CAP:-2GB}"/>
    <!-- 单模块日志保留天数与占用上限 -->
    <property name="MODULE_MAX_HISTORY" value="${LOG_MODULE_MAX_HISTORY:-30}"/>
    <property name="MODULE_TOTAL_SIZE_CAP" value="${LOG_MODULE_TOTAL_SIZE_CAP:-256MB}"/>

    <!-- 输出日志到控制台 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="com.yomahub.tlog.core.enhance.logback.AspectLogbackEncoder">
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>${LOG_CHARSET}</charset>
        </encoder>
    </appender>

    <!-- 全量应用日志（按大小与天数轮转 + 总占用上限） -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${APP_NAME}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/%d{yyyy-MM-dd}/${APP_NAME}.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>${FILE_MAX_SIZE}</maxFileSize>
            <maxHistory>${FILE_MAX_HISTORY}</maxHistory>
            <totalSizeCap>${TOTAL_SIZE_CAP}</totalSizeCap>
        </rollingPolicy>
        <encoder class="com.yomahub.tlog.core.enhance.logback.AspectLogbackEncoder">
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>${LOG_CHARSET}</charset>
        </encoder>
    </appender>

    <!-- 输出日志到文件（异步） -->
    <appender name="ASYNC_FILE" class="com.yomahub.tlog.core.enhance.logback.async.AspectLogbackAsyncAppender">
        <!-- 不丢失日志，默认：如果队列的 80% 已满，则会丢弃 TRACT、DEBUG、INFO 级别的日志 -->
        <discardingThreshold>0</discardingThreshold>
        <!-- 更改默认的队列的深度，该值会影响性能，默认：256 -->
        <queueSize>512</queueSize>
        <appender-ref ref="FILE"/>
    </appender>

    <!-- 按模块分文件输出（FR-LOG-01 按模块分文件） -->
    <appender name="MODULE_ACQ" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/module/acquisition.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/module/acquisition.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>${FILE_MAX_SIZE}</maxFileSize>
            <maxHistory>${MODULE_MAX_HISTORY}</maxHistory>
            <totalSizeCap>${MODULE_TOTAL_SIZE_CAP}</totalSizeCap>
        </rollingPolicy>
        <encoder class="com.yomahub.tlog.core.enhance.logback.AspectLogbackEncoder">
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>${LOG_CHARSET}</charset>
        </encoder>
    </appender>
    <appender name="MODULE_PROTO" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/module/protocol.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/module/protocol.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>${FILE_MAX_SIZE}</maxFileSize>
            <maxHistory>${MODULE_MAX_HISTORY}</maxHistory>
            <totalSizeCap>${MODULE_TOTAL_SIZE_CAP}</totalSizeCap>
        </rollingPolicy>
        <encoder class="com.yomahub.tlog.core.enhance.logback.AspectLogbackEncoder">
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>${LOG_CHARSET}</charset>
        </encoder>
    </appender>
    <appender name="MODULE_ALARM" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/module/alarm.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/module/alarm.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>${FILE_MAX_SIZE}</maxFileSize>
            <maxHistory>${MODULE_MAX_HISTORY}</maxHistory>
            <totalSizeCap>${MODULE_TOTAL_SIZE_CAP}</totalSizeCap>
        </rollingPolicy>
        <encoder class="com.yomahub.tlog.core.enhance.logback.AspectLogbackEncoder">
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>${LOG_CHARSET}</charset>
        </encoder>
    </appender>
    <appender name="MODULE_REPORT" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/module/report.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/module/report.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>${FILE_MAX_SIZE}</maxFileSize>
            <maxHistory>${MODULE_MAX_HISTORY}</maxHistory>
            <totalSizeCap>${MODULE_TOTAL_SIZE_CAP}</totalSizeCap>
        </rollingPolicy>
        <encoder class="com.yomahub.tlog.core.enhance.logback.AspectLogbackEncoder">
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>${LOG_CHARSET}</charset>
        </encoder>
    </appender>
    <appender name="MODULE_SYNC" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/module/sync.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/module/sync.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>${FILE_MAX_SIZE}</maxFileSize>
            <maxHistory>${MODULE_MAX_HISTORY}</maxHistory>
            <totalSizeCap>${MODULE_TOTAL_SIZE_CAP}</totalSizeCap>
        </rollingPolicy>
        <encoder class="com.yomahub.tlog.core.enhance.logback.AspectLogbackEncoder">
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>${LOG_CHARSET}</charset>
        </encoder>
    </appender>
    <appender name="MODULE_RELAY" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/module/relay.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/module/relay.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>${FILE_MAX_SIZE}</maxFileSize>
            <maxHistory>${MODULE_MAX_HISTORY}</maxHistory>
            <totalSizeCap>${MODULE_TOTAL_SIZE_CAP}</totalSizeCap>
        </rollingPolicy>
        <encoder class="com.yomahub.tlog.core.enhance.logback.AspectLogbackEncoder">
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>${LOG_CHARSET}</charset>
        </encoder>
    </appender>
    <appender name="MODULE_BUFFER" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/module/buffer.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/module/buffer.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>${FILE_MAX_SIZE}</maxFileSize>
            <maxHistory>${MODULE_MAX_HISTORY}</maxHistory>
            <totalSizeCap>${MODULE_TOTAL_SIZE_CAP}</totalSizeCap>
        </rollingPolicy>
        <encoder class="com.yomahub.tlog.core.enhance.logback.AspectLogbackEncoder">
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>${LOG_CHARSET}</charset>
        </encoder>
    </appender>

    <!-- 模块日志：同时输出到模块文件与控制台/全量日志（additivity 保持 true） -->
    <logger name="top.continew.admin.monitor.runtime.engine" additivity="true">
        <appender-ref ref="MODULE_ACQ"/>
    </logger>
    <logger name="top.continew.admin.monitor.runtime.session" additivity="true">
        <appender-ref ref="MODULE_ACQ"/>
    </logger>
    <logger name="top.continew.admin.monitor.runtime.signal" additivity="true">
        <appender-ref ref="MODULE_ACQ"/>
    </logger>
    <logger name="com.mbj.jdcompatiblemonitor.protocol" additivity="true">
        <appender-ref ref="MODULE_PROTO"/>
    </logger>
    <logger name="com.mbj.jdcompatiblemonitor.device" additivity="true">
        <appender-ref ref="MODULE_PROTO"/>
    </logger>
    <logger name="top.continew.admin.monitor.runtime.alarm" additivity="true">
        <appender-ref ref="MODULE_ALARM"/>
    </logger>
    <logger name="top.continew.admin.monitor.runtime.report" additivity="true">
        <appender-ref ref="MODULE_REPORT"/>
    </logger>
    <logger name="top.continew.admin.monitor.runtime.sync" additivity="true">
        <appender-ref ref="MODULE_SYNC"/>
    </logger>
    <logger name="top.continew.admin.monitor.runtime.relay" additivity="true">
        <appender-ref ref="MODULE_RELAY"/>
    </logger>
    <logger name="top.continew.admin.monitor.runtime.buffer" additivity="true">
        <appender-ref ref="MODULE_BUFFER"/>
    </logger>
    <logger name="com.mbj.jdcompatiblemonitor.storage" additivity="true">
        <appender-ref ref="MODULE_BUFFER"/>
    </logger>

    <!-- 如果配置的日志等级，和 application.yml 中的日志等级配置重叠，application.yml 配置优先级高 -->
    <root level="${LOG_LEVEL:-INFO}">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ASYNC_FILE"/>
    </root>
</configuration>
