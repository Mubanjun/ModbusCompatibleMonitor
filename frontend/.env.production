# 环境变量 (命名必须以 VITE_ 开头)
#
# 生产包随后端一起发布：界面由后端 8000 端口直接托管
# （见 backend/continew-server/build.gradle 的 processResources 与
#   docs/现场部署与验收手册.md「前端入口 http://<主机IP>:8000」）。
# 因此接口地址必须是「同源相对路径」，不能沿用上游模板的 https://api.continew.top——
# 否则现场打开界面后所有请求都会发给厂商云端，表现为登录永远失败。

# 是否在打包时启用 Mock
VITE_BUILD_MOCK = false

# 接口前缀：留空表示与页面同源（http://<主机IP>:8000）
# http.ts 的 baseURL 取 VITE_API_PREFIX ?? VITE_API_BASE_URL，空串即相对路径
VITE_API_PREFIX = ''

# 上游模板的默认值，本项目生产部署不使用（保留占位便于对照）
VITE_API_BASE_URL = ''
VITE_API_WS_URL = ''

# 地址前缀
VITE_BASE = '/'

# 应用配置面板
VITE_APP_SETTING = true

# 客户端ID
VITE_CLIENT_ID = 'ef51c9a3e9046c4f2ea45142c8a8344a'
