# syntax=docker/dockerfile:1.7

FROM node:22-bookworm-slim AS frontend-build
WORKDIR /src/frontend
RUN corepack enable && corepack prepare pnpm@9.3.0 --activate
ENV npm_config_registry=https://registry.npmmirror.com
COPY frontend/package.json frontend/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY frontend/ ./
RUN pnpm lint && pnpm typecheck && pnpm build

FROM eclipse-temurin:21-jdk-jammy AS backend-build
WORKDIR /src
COPY backend/ ./backend/
COPY --from=frontend-build /src/frontend/dist ./frontend/dist
WORKDIR /src/backend
RUN chmod +x gradlew && ./gradlew build --no-daemon --console=plain

FROM eclipse-temurin:21-jre-jammy AS runtime
ENV TZ=Asia/Shanghai LANG=C.UTF-8 JAVA_TOOL_OPTIONS=-Xmx1g
WORKDIR /app
COPY --from=backend-build /src/backend/continew-server/build/libs/continew-admin.jar /app/continew-admin.jar
EXPOSE 8000
ENTRYPOINT ["java", "-jar", "/app/continew-admin.jar"]
